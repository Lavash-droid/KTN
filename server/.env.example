# Sürü serverinin konfiqurasiyası. "cp .env.example .env" edib doldurun. .env repoya DÜŞMƏMƏLİDİR.
# Gizli dəyərlər üçün: openssl rand -hex 32

# --- Domen və HTTPS ---
# API-nin domeni (DNS A qeydi bu serverə yönəlməlidir). Tətbiqdə: EXPO_PUBLIC_API_URL=https://<API_DOMAIN>
API_DOMAIN=api.suru.az
PUBLIC_URL=https://api.suru.az
# Saytı da bu serverdən vermək üçün (deploy/sites/site.caddy.example-a baxın); Vercel-də qalırsa boş saxlayın
SITE_DOMAIN=

# --- Verilənlər bazası ---
# Yalnız hərf və rəqəm (URL-də problem yaratmasın): openssl rand -hex 24
POSTGRES_PASSWORD=
# Docker-siz işlədəndə: DATABASE_URL=postgres://suru:<şifrə>@localhost:5432/suru
# (docker-compose DATABASE_URL-i özü qurur)

# --- Təhlükəsizlik ---
# İmzalı şəkil URL-ləri üçün (≥ 32 simvol). Dəyişsə, köhnə şəkil keçidləri etibarsız olur (tətbiq yenisini alır).
PHOTO_URL_SECRET=
# Veb panel və saytın ünvanları (brauzerdən API-yə sorğu üçün). Telefon tətbiqi üçün lazım deyil.
CORS_ORIGINS=https://suru.az,https://www.suru.az
# Yeni qeydiyyat (false — yalnız mövcud hesablar və myGov)
ALLOW_SIGNUP=true
# Sessiyanın ömrü (gün); hər istifadədə uzanır
SESSION_TTL_DAYS=180
MAX_PHOTO_MB=5

# --- Ehtiyat nüsxə ---
BACKUP_DIR=./backups
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
TZ=Asia/Baku

# --- myGov / dövlət girişi (mobile/docs/MYGOV.md) ---
# Provayderdə qeydiyyat üçün qayıdış ünvanı: https://<API_DOMAIN>/auth/mygov/callback
# MYGOV_CLIENT_ID=
# MYGOV_CLIENT_SECRET=
# MYGOV_ISSUER=
# MYGOV_STATE_SECRET=
# Supabase-dəki ilə EYNİ olmalıdır, yoxsa myGov istifadəçiləri hesablarına bağlılığı itirər:
# MYGOV_ID_SECRET=
# MYGOV_ALLOWED_REDIRECTS=suru://,https://suru.az
# MYGOV_SUBJECT_CLAIM=sub
