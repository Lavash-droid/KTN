{
  "name": "suru-server",
  "version": "1.0.0",
  "private": true,
  "description": "Sürü daxili (fiziki) server: Postgres + REST API + şəkil anbarı — Supabase-in əvəzi",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "node scripts/build.mjs",
    "migrate": "tsx src/cli.ts migrate",
    "import:supabase": "tsx scripts/migrate-from-supabase.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.19",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.21",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  }
}
