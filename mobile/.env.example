# Sürü mobil tətbiqinin konfiqurasiyası. Bu faylı ".env" adı ilə kopyalayın və doldurun.
# EXPO_PUBLIC_ ilə başlayan dəyişənlər tətbiqin içinə yığılır — bura heç vaxt gizli açar
# (service_role və s.) yazmayın. Supabase-in "publishable"/"anon" açarı açıq olmaq üçün nəzərdə tutulub;
# məlumatı Row Level Security qaydaları qoruyur.

# Backend: supabase | rest | local   (boş qalsa: SUPABASE_URL varsa supabase, yoxsa local)
EXPO_PUBLIC_BACKEND=supabase

# Supabase → Project Settings → API ("suru" layihəsi, eu-central-1)
EXPO_PUBLIC_SUPABASE_URL=https://rutlmhwzintycizfpgyv.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_fS-KjISyVodT6azL2s8Vfg_chgnWdMp

# Gələcəkdə daxili server (EXPO_PUBLIC_BACKEND=rest olanda)
# EXPO_PUBLIC_API_URL=https://api.suru.az

